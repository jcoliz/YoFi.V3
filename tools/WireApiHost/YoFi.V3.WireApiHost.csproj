<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="NSwag.AspNetCore" />
    <PackageReference Include="NSwag.MSBuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Controllers\YoFi.V3.Controllers.csproj" />
  </ItemGroup>

  <Target Name="NSwag" AfterTargets="PostBuildEvent">
    <Exec WorkingDirectory="$(ProjectDir)" Command="$(NSwagExe_Net100) run $(ProjectDir)\nswag.json /variables:Configuration=$(Configuration),MSBuildOutputPath=$(OutputPath),MSBuildProjectFile=$(MSBuildProjectFile),OutputFile=../../src/FrontEnd.Nuxt/app/utils/apiclient.ts"/>
    <Exec WorkingDirectory="$(ProjectDir)" Command="$(NSwagExe_Net100) run $(ProjectDir)\nswag-test-control.json /variables:Configuration=$(Configuration),MSBuildOutputPath=$(OutputPath),MSBuildProjectFile=$(MSBuildProjectFile),OutputFile=../../tests/Functional/Infrastructure/TestControl/openapi-test-control.json"/>
  </Target>

</Project>
