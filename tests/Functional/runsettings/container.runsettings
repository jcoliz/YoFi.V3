<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<TestRunParameters>
		<Parameter name="webAppUrl" value="http://localhost:5000/" />
		<Parameter name="apiBaseUrl" value="http://localhost:5001/" />
		<Parameter name="defaultTimeout" value="5000" />
		<Parameter name="screenshotContext" value="Container" />
		<Parameter name="userName" value="Tester" />
		<Parameter name="userPassword" value="{TESTPWORD}" />
	</TestRunParameters>
	 <RunConfiguration>
	   <MaxCpuCount>1</MaxCpuCount>
	   <EnvironmentVariables>
	     <PWDEBUG>0</PWDEBUG>
	   </EnvironmentVariables>
	 </RunConfiguration>
	 <NUnit>
	   <NumberOfTestWorkers>1</NumberOfTestWorkers>
	 </NUnit>
</RunSettings>
